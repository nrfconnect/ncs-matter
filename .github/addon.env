# SDK sync configuration for .github/workflows/sdk-sync.yml
# Single-line KEY=VALUE records; no shell expansion.

# Manifest projects to bump. Names must match west.yml project names.
SDK_SYNC_PROJECTS=nrf,matter
SDK_SYNC_PROJECT_nrf=repo=nrfconnect/sdk-nrf branch=main rebase=false
SDK_SYNC_PROJECT_matter=repo=nrfconnect/sdk-connectedhomeip branch=ncs-sync rebase=true base=master

# Twister sample under the add-on repo (relative path).
SDK_SYNC_TWISTER_PATH=samples/template
SDK_SYNC_TWISTER_SCENARIO=sample.matter.template.debug
SDK_SYNC_TWISTER_ALL=true

SDK_SYNC_MAIN_BRANCH=main
SDK_SYNC_INTEGRATION_BRANCH=ncs-sync
SDK_SYNC_PR_BRANCH=sdk-sync/test
SDK_SYNC_PR_LABEL=ci-disabled
