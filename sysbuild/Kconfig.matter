menuconfig MATTER_ADD_ON
	bool "Matter"
	depends on ZEPHYR_CONNECTEDHOMEIP_MODULE

if MATTER_ADD_ON

config MATTER_ADD_ON_FACTORY_DATA_GENERATE
	bool "Create Matter factory data"
	help
	  Generate Matter factory data set and the HEX file for the sample during the building
	  process.

config MATTER_ADD_ON_FACTORY_DATA_MERGE_WITH_FIRMWARE
	bool "Merge generated factory data with merged.hex output"
	depends on MATTER_ADD_ON_FACTORY_DATA_GENERATE
	default y
	help
	  Enables merging the generated factory data with the merged.hex output build file. As a
	  result, the merged.hex build output file, which is used when flashing the firmware using
	  the west tool, includes the factory data as well.

config MATTER_ADD_ON_OTA
	bool "Matter Add-On OTA Software Update"
	default y
	help
	  Enables over-the-air (OTA) Requestor role that allows the node to perform Device Firmware
	  Update by querying and downloading a new firmware image from a peer OTA Provider node.

config MATTER_ADD_ON_OTA_IMAGE_FILE_NAME
	string "OTA image file name"
	default "matter.ota"
	depends on MATTER_ADD_ON_OTA
	help
	  Provides the file name of the generated Matter OTA image in the build directory.

endif # MATTER_ADD_ON

config MATTER_ROOT_PATH
	string "Path to the Matter root directory"
	default "${ZEPHYR_BASE}/../modules/lib/matter"
	help
	  Path to the Matter root folder to which all scripts and CMake configuration
	  will point within the ncs-matter repository.
	  Change this value to your Matter root directory if the path is different than
	  the default one: $ZEPHYR_BASE/../modules/lib/matter.
